# DEVELOPMENT ONLY — synthetic demo. Change every value outside localhost. Never commit a real .env.
POSTGRES_PASSWORD=dev-postgres
EMPLOYER_DB_PASSWORD=dev-employer
MEMBER_DB_PASSWORD=dev-member
CONTRIBUTION_DB_PASSWORD=dev-contribution
CLAIM_DB_PASSWORD=dev-claim
PAYMENT_SIMULATOR_DB_PASSWORD=dev-payment-simulator
WORKFLOW_DB_PASSWORD=dev-workflow
GRIEVANCE_DB_PASSWORD=dev-grievance
AUDIT_DB_PASSWORD=dev-audit
REPORTING_DB_PASSWORD=dev-reporting
INTELLIGENCE_DB_PASSWORD=dev-intelligence
PENSION_DB_PASSWORD=dev-pension
PLATFORM_DB_PASSWORD=dev-platform
MOCK_INTEGRATIONS_DB_PASSWORD=dev-mock-integrations
COMPLIANCE_DB_PASSWORD=dev-compliance
KEYCLOAK_DB_PASSWORD=dev-keycloak-db
REPORTING_RO_DB_PASSWORD=dev-reporting-ro
RABBITMQ_USER=epfo
RABBITMQ_PASSWORD=dev-rabbitmq
# S3-compatible object store (SeaweedFS); must match infra/object-store/s3.json
OBJECT_STORE_ACCESS_KEY=epfo-dev-access
OBJECT_STORE_SECRET_KEY=epfo-dev-secret-change-me
KEYCLOAK_ADMIN_PASSWORD=dev-keycloak-admin
KEYCLOAK_PUBLIC_ISSUER=http://localhost:8080/realms/epfo-demo
KEYCLOAK_CLIENT_ID=epfo-bff
KEYCLOAK_CLIENT_SECRET=change-me-bff-secret
# Fernet key for gateway sessions (generate: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())')
GATEWAY_SESSION_FERNET_KEY=_tOgo_qfaIhUHi1a1OBjwSVjhsdpfouzbE_AbPW9Yso=
# Empty = the gateway creates an ephemeral Ed25519 signing key at start-up (fine for local demos).
GATEWAY_SIGNING_KEY_PEM=
WEB_CONCURRENCY=1
DB_POOL_SIZE=5

# AI (init.md §8.1): disabled | ollama | openai_compatible (the last also needs AI_ALLOW_EXTERNAL=1)
AI_PROVIDER=disabled
AI_MODEL=qwen2.5:0.5b
