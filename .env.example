# Fernet key for gateway sessions (generate: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())')
GATEWAY_SESSION_KEY=6nb3YyjbKq0p9fN8vPqvT1xq6aGqz3Ww9o2y5c7c8E0=
# Empty = the gateway creates an ephemeral Ed25519 signing key at start-up (fine for local demos).
GATEWAY_SIGNING_KEY_PEM=
WEB_CONCURRENCY=1
DB_POOL_SIZE=5
